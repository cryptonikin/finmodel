# Шаблон D:\finmodel\secrets\finmodel.env — скопируйте ВНЕ репозитория и заполните.
# В git этот файл с реальными значениями НЕ кладётся.

# ID таблиц Google (часть адреса между /d/ и /edit)
SHEET_INVEST_ID=
SHEET_BUDGET_ID=

# Часовой пояс
TZ=Europe/Moscow

# Формат логов в консоли: text | json
FINMODEL_LOG_FORMAT=text

# Ф1: фильтр счетов Т-Банка — «все» или маски …1234 через запятую
# TINVEST_ACCOUNTS=все
